# Copie para .env e ajuste se necessário. Nenhuma das chaves é obrigatória para o MVP local.

# Caminhos (defaults sensatos se não definir)
LEX_RAG_DATA_DIR=./data
LEX_RAG_QDRANT_PATH=./data/qdrant
LEX_RAG_RAW_CACHE_PATH=./data/raw
LEX_RAG_STATE_DB=./data/state.sqlite

# Modelos
LEX_RAG_EMBEDDING_MODEL=BAAI/bge-m3
LEX_RAG_RERANKER_MODEL=BAAI/bge-reranker-v2-m3

# Thresholds (calibrar com eval)
LEX_RAG_RERANKER_SCORE_MIN=0.55
LEX_RAG_DENSE_PREFETCH_LIMIT=40
LEX_RAG_SPARSE_PREFETCH_LIMIT=40

# HTTP — o default (config.py) é um UA de navegador; o Planalto recusa UAs que não pareçam navegador.
# LEX_RAG_HTTP_USER_AGENT=
LEX_RAG_HTTP_MAX_PARALLEL=4

# Logging
LEX_RAG_LOG_LEVEL=INFO
